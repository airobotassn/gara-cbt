# 리눅스(Spring 서버) 용 — 부팅하면 코드가 알아서 뜬다.
#
#   ⚠️ 사람이 브라우저를 켜지 않는다. systemd 가 node 를 띄우고, node 가 Edge 를 띄운다.
#   ⚠️ 워커는 브라우저가 죽으면 스스로 종료한다 → Restart=always 가 다시 띄운다.
#      "살아있는 척 헛도는 상태"를 만들지 않는 게 이 조합의 핵심이다.
#   ⚠️ headless 로 돌기 때문에 X 서버가 필요 없다(실측 확인).
#
# 설치:
#   sudo cp gara-translate-worker.service /etc/systemd/system/
#   sudo mkdir -p /etc/gara && sudo nano /etc/gara/translate-worker.env   # 아래 형식
#   sudo systemctl daemon-reload && sudo systemctl enable --now gara-translate-worker
#
# /etc/gara/translate-worker.env  (권한 600 — 키가 평문이다)
#   SUPABASE_URL=https://xxx.supabase.co
#   SUPABASE_ANON_KEY=eyJ...
#   TRANSLATE_WORKER_KEY=gara-worker-...
#
# 사전 준비: Microsoft Edge 148+ 설치
#   curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /usr/share/keyrings/microsoft.gpg
#   echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/edge stable main" \
#     | sudo tee /etc/apt/sources.list.d/microsoft-edge.list
#   sudo apt update && sudo apt install microsoft-edge-stable

[Unit]
Description=GARA 채팅 번역 워커 (Edge 온디바이스)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gara
WorkingDirectory=/srv/gara-cbt
EnvironmentFile=/etc/gara/translate-worker.env
# ⚠️ 프로필은 저장소 밖에 둔다 — 안에 두면 개발서버 파일 감시자가 잠긴 파일에서 죽고,
#    언어팩(수 GB)이 소스 트리에 쌓인다.
Environment=TRANSLATE_PROFILE_DIR=/var/lib/gara/translate-profile
ExecStart=/usr/bin/node tools/translate-worker/worker.mjs

# 워커가 스스로 끝내는 경우(브라우저 사망)를 포함해 항상 다시 띄운다.
Restart=always
RestartSec=5
# 계속 실패하며 무한 재시작하는 걸 막는다 — 5분에 10번 넘게 죽으면 멈추고 사람을 부른다.
StartLimitIntervalSec=300
StartLimitBurst=10

# 브라우저가 메모리를 물고 늘어지면 여기서 잘린다(재시작으로 회복).
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gara-translate

[Install]
WantedBy=multi-user.target
