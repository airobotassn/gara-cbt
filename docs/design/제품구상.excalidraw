    {
      "id": "2hyMwX_zaI21zeWF46FD7",
      "type": "text",
      "x": 1182.4166666666667,
      "y": 347.08333333333326,
      "width": 614.3197631835938,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
