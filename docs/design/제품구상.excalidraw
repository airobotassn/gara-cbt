      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685233,
      "link": null,
      "locked": false,
      "text": "장기엔 무게중심이 유저 → 기업(B2B)으로 넘어갈 가능성",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "장기엔 무게중심이 유저 → 기업(B2B)으로 넘어갈 가능성",
