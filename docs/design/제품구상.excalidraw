      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "지역 순위 산정",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0tqcME9weP8FXDA6gyiwI",
      "type": "text",
      "x": 1482.5151648142983,
      "y": 6200.738095238095,
      "width": 438.1998291015625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
