      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685233,
      "link": null,
      "locked": false,
      "text": "게임·강의는 유입·리텐션 담당, 자체 매출 기대 안 함",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "게임·강의는 유입·리텐션 담당, 자체 매출 기대 안 함",
