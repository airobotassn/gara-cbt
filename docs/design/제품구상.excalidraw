      "lineHeight": 1.25
    },
    {
      "id": "ab1E1B_izqTXgtQRy8-ft",
      "type": "text",
      "x": 1304.9952063182045,
      "y": 1938.2380952380956,
      "width": 793.23974609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 148586754,
      "version": 3,
      "versionNonce": 1676912450,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685233,
      "link": null,
      "locked": false,
      "text": "지역 순위 = 성실 참여 기여의 1인당 합(인구 보정) × 활성 참여율 가중. 문제 풀 때마다 \"내가\n우리 지역을 올렸다\"를 즉시 피드백하고, 기여는 제대로 푼 것만 인정한다.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "지역 순위 = 성실 참여 기여의 1인당 합(인구 보정) × 활성 참여율 가중. 문제 풀 때마다 \"내가 우리 지역을 올렸다\"를 즉시 피드백하고, 기여는 제대로 푼 것만 인정한다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZQhQfi2N98FCNUWy1iTKP",
      "type": "text",
      "x": 1307.9352087596108,
      "y": 1998.2380952380956,
      "width": 787.3597412109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1983301662,
      "version": 3,
      "versionNonce": 1139729886,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685233,
      "link": null,
      "locked": false,
      "text": "이런식으로 정리해서 줘봐조직화된 게임 설계 요소들을 선호 형식으로 재구성했다조직화된 게\n임 설계 요소들을 선호 형식으로 재구성했다딱 그 스타일로, 오늘 정한 거 전부 압축했어요.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이런식으로 정리해서 줘봐조직화된 게임 설계 요소들을 선호 형식으로 재구성했다조직화된 게임 설계 요소들을 선호 형식으로 재구성했다딱 그 스타일로, 오늘 정한 거 전부 압축했어요.",
      "autoResize": false,
      "lineHeight": 1.25
    },
