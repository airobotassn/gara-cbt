      "versionNonce": 96884226,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685234,
      "link": null,
      "locked": false,
      "text": "Claude의 응답이 중단되었습니다.아니 지역간 경쟁 저것만국가·지역 경쟁",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Claude의 응답이 중단되었습니다.아니 지역간 경쟁 저것만국가·지역 경쟁",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "da4O1LUmtcpqAQtUyxwUq",
      "type": "text",
      "x": 1683.4550909617592,
      "y": 5535.738095238095,
      "width": 36.319976806640625,
      "height": 25,
      "angle": 0,
