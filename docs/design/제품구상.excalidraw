      "versionNonce": 1562891166,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783909685234,
      "link": null,
      "locked": false,
      "text": "왜 넣어도 되나",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "왜 넣어도 되나",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
